#!/bin/bash

${common_bootstrap_content}

${docker_init_content}

cat << 'EOF' > docker-compose.yml
${docker_compose_content}
EOF

if [ ! -z "${init_sql_content}" ]; then
cat << 'EOF' > mysql_init.sql
${init_sql_content}
EOF
fi

# 기존에 가동 중이던 컨테이너가 있다면 안전하게 내리고, 최신 이미지를 당긴 후 올립니다.
sudo docker-compose down || true
sudo docker-compose pull || true
sudo docker-compose up -d

echo "========================================================================="
echo " Successfully initialized and started ${app_name} infrastructure! "
echo "========================================================================="